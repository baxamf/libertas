    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.11.2",
    "typescript": "6.0.3"
  },
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=22"
  }
}
