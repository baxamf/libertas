{
  "name": "libertas",
  "version": "0.0.1",
  "description": "Monorepo Turborepo starter with NestJS 12, Next.js 16, Prisma 8, PostgreSQL",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
