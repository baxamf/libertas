{
  "name": "@repo/shared-types",
  "version": "0.0.1",
  "description": "Shared Zod Schemas and types for the monorepo",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "check-types": "tsc --noEmit",
    "lint": "oxlint src/"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.4",
    "zod": "^4.4.3",
    "@repo/db": "workspace:*"
  },
  "devDependencies": {
    "oxlint": "^1.82.0"
  }
}
